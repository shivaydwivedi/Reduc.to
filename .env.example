NODE_ENV=development
API_HOST=127.0.0.1
PORT=3000
API_PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
READINESS_TIMEOUT_MS=1000
SHUTDOWN_TIMEOUT_MS=10000
ACCESS_TOKEN_SECRET=replace-with-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=localhost
PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

POSTGRES_DB=reduc_to_dev
POSTGRES_USER=reduc_to
POSTGRES_PASSWORD=reduc_to_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://reduc_to:reduc_to_dev_password@localhost:5432/reduc_to_dev

REDIS_PORT=6379
# REDIS_URL is optional for the MVP API; redirect caching is deferred.
REDIS_URL=redis://localhost:6379
