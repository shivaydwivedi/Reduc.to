generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
}

enum RedirectType {
  TEMPORARY_302
  PERMANENT_301
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  BOT
  UNKNOWN
}

model User {
  id              String           @id @db.Uuid
  email           String           @unique @db.Text
  displayEmail    String?          @map("display_email") @db.Text
  passwordHash    String           @map("password_hash") @db.Text
  displayName     String?          @map("display_name") @db.Text
  role            UserRole         @default(USER)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  links           Link[]
  refreshSessions RefreshSession[]

  @@map("users")
}

model Link {
  id                  String               @id @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  displayKey          String               @map("display_key") @db.Text
  lookupKey           String               @unique @map("lookup_key") @db.Text
  destinationUrl      String               @map("destination_url") @db.Text
  title               String?              @db.Text
  isActive            Boolean              @default(true) @map("is_active")
  expiresAt           DateTime?            @map("expires_at") @db.Timestamptz(3)
  redirectType        RedirectType         @default(TEMPORARY_302) @map("redirect_type")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz(3)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  clickEvents         ClickEvent[]
  dailyLinkStatistics DailyLinkStatistic[]

  @@index([userId, createdAt(sort: Desc)], map: "links_user_id_created_at_idx")
  @@index([userId, updatedAt(sort: Desc)], map: "links_user_id_updated_at_idx")
  @@index([userId, isActive, createdAt(sort: Desc)], map: "links_user_id_is_active_created_at_idx")
  @@index([userId, expiresAt], map: "links_user_id_expires_at_idx")
  @@map("links")
}

model RefreshSession {
  id               String         @id @db.Uuid
  userId           String         @map("user_id") @db.Uuid
  familyId         String         @map("family_id") @db.Uuid
  expiresAt        DateTime       @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime?      @map("revoked_at") @db.Timestamptz(3)
  revocationReason String?        @map("revocation_reason") @db.VarChar(64)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  refreshTokens    RefreshToken[]

  @@index([userId, revokedAt, expiresAt], map: "refresh_sessions_user_id_revoked_at_expires_at_idx")
  @@index([expiresAt], map: "refresh_sessions_expires_at_idx")
  @@map("refresh_sessions")
}

model RefreshToken {
  id                    String         @id @db.Uuid
  sessionId             String         @map("session_id") @db.Uuid
  tokenHash             String         @unique @map("token_hash") @db.Text
  issuedAt              DateTime       @map("issued_at") @db.Timestamptz(3)
  expiresAt             DateTime       @map("expires_at") @db.Timestamptz(3)
  consumedAt            DateTime?      @map("consumed_at") @db.Timestamptz(3)
  revokedAt             DateTime?      @map("revoked_at") @db.Timestamptz(3)
  replacedByTokenId     String?        @unique @map("replaced_by_token_id") @db.Uuid
  session               RefreshSession @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  replacedByToken       RefreshToken?  @relation("RefreshTokenReplacement", fields: [replacedByTokenId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replacedRefreshTokens RefreshToken[] @relation("RefreshTokenReplacement")

  @@index([sessionId, issuedAt], map: "refresh_tokens_session_id_issued_at_idx")
  @@index([sessionId, consumedAt, revokedAt], map: "refresh_tokens_session_id_consumed_at_revoked_at_idx")
  @@index([expiresAt], map: "refresh_tokens_expires_at_idx")
  @@map("refresh_tokens")
}

model ClickEvent {
  id                    String      @id @db.Uuid
  linkId                String      @map("link_id") @db.Uuid
  occurredAt            DateTime    @map("occurred_at") @db.Timestamptz(3)
  visitorHash           String?     @map("visitor_hash") @db.Text
  referrerHost          String?     @map("referrer_host") @db.Text
  browserFamily         String?     @map("browser_family") @db.Text
  operatingSystemFamily String?     @map("operating_system_family") @db.Text
  deviceType            DeviceType? @map("device_type")
  isBot                 Boolean     @default(false) @map("is_bot")
  source                String?     @db.Text
  link                  Link        @relation(fields: [linkId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([linkId, occurredAt(sort: Desc)], map: "click_events_link_id_occurred_at_idx")
  @@index([linkId, visitorHash, occurredAt], map: "click_events_link_id_visitor_hash_occurred_at_idx")
  @@index([occurredAt], map: "click_events_occurred_at_idx")
  @@map("click_events")
}

model DailyLinkStatistic {
  id                        String   @id @db.Uuid
  linkId                    String   @map("link_id") @db.Uuid
  date                      DateTime @db.Date
  totalClicks               Int      @default(0) @map("total_clicks")
  approximateUniqueVisitors Int      @default(0) @map("approximate_unique_visitors")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  link                      Link     @relation(fields: [linkId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([linkId, date], map: "daily_link_statistics_link_id_date_key")
  @@map("daily_link_statistics")
}
